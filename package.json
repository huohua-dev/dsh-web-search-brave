{
  "name": "@huohua-dev/dsh-web-search-brave",
  "version": "0.1.0",
  "description": "Brave Search API-backed web search provider for the DeepSeek Harness web capability seam (ctx.web). One search is one HTTP request - no model turn.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "web-search",
    "brave",
    "brave-search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huohua-dev/dsh-web-search-brave.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "optionalDependencies": {
    "undici": "^6.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.1.1-rc.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.1-rc.0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-web": ">=0.1.1-rc.0"
  },
  "devDependencies": {
    "undici": "^6.21.0",
    "vitest": "^3.2.7"
  }
}
